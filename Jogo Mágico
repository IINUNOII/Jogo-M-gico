<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Mundo das Frases Mágicas</title>
    <style>
        body {
            font-family: 'Comic Sans MS', cursive;
            background: linear-gradient(45deg, #83a4d4, #b6fbff);
            text-align: center;
            padding: 20px;
        }

        #game-screen {
            background: white;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
            max-width: 600px;
            margin: auto;
        }

        #luna-character {
            width: 120px;
            transition: transform 0.3s;
        }

        .scenario-img {
            width: 300px;
            margin: 20px;
        }

        #answer-input {
            font-size: 18px;
            padding: 10px;
            width: 80%;
            margin: 10px;
            border: 3px solid #83a4d4;
            border-radius: 10px;
        }

        button {
            background: #ff9f43;
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 18px;
            cursor: pointer;
            transition: transform 0.2s;
        }

        button:hover {
            transform: scale(1.1);
        }

        .feedback {
            font-size: 24px;
            margin: 10px;
        }

        .customization-item {
            width: 50px;
            margin: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div id="game-screen">
        <h1>🌙 Mundo das Frases Mágicas ✨</h1>
        <img id="scenario-img" class="scenario-img" src="https://img.icons8.com/color/96/forest.png">
        <div>
            <img id="luna-character" src="https://img.icons8.com/color/96/fairy.png" alt="Luna">
        </div>
        <p id="current-sentence" class="feedback">Vamos começar!</p>
        <input type="text" id="answer-input" placeholder="Escreva seu feitiço aqui...">
        <br>
        <button onclick="checkAnswer()">Lançar Feitiço! ✨</button>
        <p id="feedback" class="feedback"></p>
        <div id="customization-panel">
            <h3>Itens Mágicos:</h3>
            <img src="https://img.icons8.com/color/48/witch-hat.png" class="customization-item" onclick="equipItem('hat')">
            <img src="https://img.icons8.com/color/48/fairy-wand.png" class="customization-item" onclick="equipItem('wand')">
        </div>
    </div>

    <script>
        const sentences = {
            level1: [
                {affirmative: "O gato está dormindo.", negative: "O gato não está dormindo."},
                {affirmative: "A flor é vermelha.", negative: "A flor não é vermelha."},
                {affirmative: "O sol brilha.", negative: "O sol não brilha."}
            ],
            level2: [
                {affirmative: "Os pássaros voaram.", negative: "Os pássaros não voaram."},
                {affirmative: "As crianças riram.", negative: "As crianças não riram."}
            ]
        };

        let currentLevel = 1;
        let currentSentence = null;
        let score = 0;

        function startGame() {
            loadRandomSentence();
            updateScenario();
        }

        function loadRandomSentence() {
            const levelKey = `level${currentLevel}`;
            const randomIndex = Math.floor(Math.random() * sentences[levelKey].length);
            currentSentence = sentences[levelKey][randomIndex];
            
            // Escolhe aleatoriamente se mostra afirmativa ou negativa
            const showAffirmative = Math.random() > 0.5;
            document.getElementById('current-sentence').textContent = showAffirmative 
                ? `"${currentSentence.affirmative}"` 
                : `"${currentSentence.negative}"`;
        }

        function checkAnswer() {
            const userAnswer = document.getElementById('answer-input').value.toLowerCase().trim();
            const correctAnswer = currentSentence.affirmative === document.getElementById('current-sentence').textContent.slice(1,-1) 
                                ? currentSentence.negative 
                                : currentSentence.affirmative;

            if(userAnswer === correctAnswer.toLowerCase()) {
                document.getElementById('feedback').innerHTML = "✨ Feitiço correto! O mundo se transforma!";
                document.getElementById('feedback').style.color = "green";
                score++;
                animateSuccess();
                setTimeout(loadRandomSentence, 1500);
            } else {
                document.getElementById('feedback').innerHTML = "🧙♀️ Oops! Tente novamente! Dica: " + (correctAnswer.includes("não") ? "Adicione 'não'!" : "Remova 'não'!");
                document.getElementById('feedback').style.color = "red";
                animateError();
            }
            document.getElementById('answer-input').value = "";
        }

        function animateSuccess() {
            document.getElementById('scenario-img').style.transform = "scale(1.1)";
            setTimeout(() => {
                document.getElementById('scenario-img').style.transform = "scale(1)";
            }, 500);
        }

        function animateError() {
            document.getElementById('luna-character').style.transform = "rotate(10deg)";
            setTimeout(() => {
                document.getElementById('luna-character').style.transform = "rotate(0deg)";
            }, 500);
        }

        function equipItem(type) {
            const luna = document.getElementById('luna-character');
            if(type === 'hat') {
                luna.src = "https://img.icons8.com/color/96/witch-hat.png";
            } else if(type === 'wand') {
                luna.src = "https://img.icons8.com/color/96/fairy-wand.png";
            }
        }

        function updateScenario() {
            const scenarioImg = document.getElementById('scenario-img');
            scenarioImg.src = currentLevel === 1 
                ? "https://img.icons8.com/color/96/forest.png" 
                : "https://img.icons8.com/color/96/castle.png";
        }

        // Inicia o jogo
        startGame();
    </script>
</body>
</html>
